{
  "name": "tenderfit-ai",
  "version": "0.1.0",
  "private": true,
  "description": "ТендерФит — прототип сервиса поиска и объяснимого анализа закупок по 44-ФЗ и 223-ФЗ",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "scrape:eis": "tsx scripts/scrape-eis.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "7z-wasm": "^1.2.0",
    "cheerio": "1.0.0",
    "date-fns": "3.6.0",
    "docx": "^9.7.2",
    "dotenv": "^18.0.1",
    "jszip": "^3.10.2",
    "lucide-react": "0.446.0",
    "mammoth": "^1.12.3",
    "next": "14.2.15",
    "node-unrar-js": "^2.0.2",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5",
    "zod": "3.23.8"
