# Окружение приложения TenderFit на сервере в России (/etc/tenderfit/app.env) — ОБРАЗЕЦ БЕЗ КЛЮЧЕЙ.
#
# Здесь только переменные ОПЛАТЫ ПОДПИСКИ (Точка Банк). Остальное окружение приложения (база,
# AUTH_SECRET, SMTP_*, LLM_*, ADMIN_EMAILS, APP_BASE_URL…) описано в deploy/worker.env.example и
# README: часть значений общая с воркером.
#
# Формат systemd: KEY=VALUE без кавычек и без пробелов вокруг «=», комментарий — целой строкой.
#
# Ключи Точки лежат в ОТДЕЛЬНОМ файле /etc/tenderfit/tochka.env (640 root:tenderfit) и подключаются
# к обоим юнитам — приложению (вебхук, выставление счетов) и воркеру (опрос статуса счетов):
#
#   sudo install -m 640 -o root -g tenderfit /dev/null /etc/tenderfit/tochka.env
#   sudo nano /etc/tenderfit/tochka.env            # заполнить по образцу ниже
#   # в tenderfit-app.service и tenderfit-worker.service, секция [Service]:
#   #   EnvironmentFile=/etc/tenderfit/tochka.env
#   sudo systemctl daemon-reload && sudo systemctl restart tenderfit-app tenderfit-worker
#
# ---- /etc/tenderfit/tochka.env ------------------------------------------
# JWT-ключ из интернет-банка (Сервисы → Интеграции и API → JWT-ключи). Нужны разрешения
# ManageInvoiceData (счета и акты), ManageWebhookData (вебхуки), ReadAccountsBasic. В журнал и
# в ответы клиентам не попадает; срок жизни ключа ограничен — перевыпуск меняет и client_id.
TOCHKA_JWT=
# client_id — виден рядом с JWT-ключом; нужен для управления вебхуками (scripts/tochka-webhook-register.ts).
TOCHKA_CLIENT_ID=
# Код клиента компании — тот, что у счетов (Get Accounts List → customerCode), НЕ customer_code из JWT.
TOCHKA_CUSTOMER_CODE=304550680
# Расчётный счёт, на который приходят оплаты, в формате «<20 цифр счёта>/<БИК>», например
# 40802810000000000001/044525104. Без него счета не выставляются. По номеру счёта приложение
# отбирает входящие платежи (на другие счета компании подписка не включается).
TOCHKA_ACCOUNT_ID=
# Необязательно:
# Адрес API; по умолчанию https://enter.tochka.com/uapi.
# TOCHKA_API_BASE=
# 1 — песочница банка (https://enter.tochka.com/sandbox/v2, токен sandbox.jwt.token, тестовые код клиента
# и счёт из документации). Боевой JWT в песочницу не отправляется. Ответы песочницы фиксированные.
# TOCHKA_SANDBOX=1
# Ставка НДС в позиции счёта и акта. Владелец на УСН — «Без НДС» (значение по умолчанию without_nds).
# Если банк не принял — nds_0 или другое значение из перечня банка.
# TOCHKA_NDS_KIND=without_nds
# 0 — не создавать закрывающий акт после оплаты (по умолчанию акт создаётся и отправляется плательщику).
# TOCHKA_CLOSING_DOCS=0
# Запасной открытый ключ банка для проверки подписи вебхуков (JWK-JSON одной строкой или PEM) на случай,
# если с сервера недоступен https://enter.tochka.com/doc/openapi/static/keys/public.
# TOCHKA_WEBHOOK_PUBLIC_KEY=
#
# ---- /etc/tenderfit/app.env ---------------------------------------------
# Секрет подписи ссылки «подтвердить оплату» в письме владельцу (заявки «Я оплатил» по СБП-QR).
# Не короче 16 знаков, случайный: `openssl rand -hex 32`. Не задан или короткий — оплата по QR выключена
# (кнопка «Я оплатил» отвечает «временно недоступна»), счета по реквизитам работают.
PAYMENT_CONFIRM_SECRET=
# Адрес приложения для ссылок в письмах и адреса вебхука (по умолчанию https://tender-fit.ru).
# APP_BASE_URL=https://tender-fit.ru
# Почты администраторов — получают «Оплачено…», «Платёж не сопоставлен», заявки по QR.
# ADMIN_EMAILS=
# Письма (клиенту «Оплата получена», владельцу) уходят через SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD.
