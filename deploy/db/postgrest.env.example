# /etc/tenderfit/postgrest.env — chmod 600, владелец root.
# Строка подключения к Beget Cloud PostgreSQL (данные из панели Beget, приватная сеть, если VPS в том же регионе).
PGRST_DB_URI=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
PGRST_DB_SCHEMAS=public
# Роль запросов: пользователь базы из панели. PostgREST слушает только 127.0.0.1, снаружи недоступен.
PGRST_DB_ANON_ROLE=USER
# Секрет подписи JWT (64+ случайных знака). SUPABASE_SERVICE_ROLE_KEY приложения — JWT {"role":"USER"}, подписанный им.
PGRST_JWT_SECRET=CHANGE_ME
PGRST_SERVER_HOST=127.0.0.1
PGRST_SERVER_PORT=3010
PGRST_DB_POOL=10
# Схема меняется миграциями: перечитать её — `sudo systemctl kill -s SIGUSR1 tenderfit-postgrest`.
