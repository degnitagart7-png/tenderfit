# Окружение воркера TenderFit на сервере в России — ОБРАЗЕЦ БЕЗ КЛЮЧЕЙ.
#
# Заполненный файл живёт вне дерева проекта, рядом с ним ключей быть не должно:
# код копируется на сервер целиком, и .env.local в архив деплоя не попадает.
#
#   sudo install -d -m 750 /etc/tenderfit
#   sudo cp deploy/worker.env.example /etc/tenderfit/worker.env
#   sudo chown root:tenderfit /etc/tenderfit/worker.env
#   sudo chmod 640 /etc/tenderfit/worker.env
#   sudo nano /etc/tenderfit/worker.env      # заполнить значения
#   sudo systemctl restart tenderfit-worker  # EnvironmentFile читается при старте
#
# Формат systemd: KEY=VALUE без кавычек и без пробелов вокруг «=», комментарий —
# только целой строкой. Значения, совпадающие с переменными Vercel, берутся
# оттуда же: расхождение ключей дало бы две базы вместо одной.

# ---- База (обязательно) -------------------------------------------------
# Supabase в Стокгольме доступен и с российского адреса, поэтому общего
# хранилища достаточно: отдельного протокола между продом и сервером нет.
# Нужен ключ роли service, а не анонимный: воркер пишет закупки, документы
# и очередь заданий.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Воркер -------------------------------------------------------------
# Имя в пульсе. Прод читает состояние сервера по этому же имени; значение
# ru-vps совпадает с DEFAULT_WORKER_ID в src/domain/workerStatus.ts, поэтому
# отдельная переменная SYNC_WORKER_ID на Vercel не нужна. Если имя меняют
# здесь — меняют и там, иначе панель будет вечно показывать «ещё не выходил
# на связь».
SYNC_WORKER_ID=ru-vps
# Период планового прогона в часах. Два — как было в расписании Windows.
SYNC_INTERVAL_HOURS=2
# Как часто плановый прогон опрашивает медленный трек, часы. Росэлторг, Фабрикант
# и ЭТП ГПБ тратят отдельный запрос карточки на каждую процедуру (86 секунд из
# 280 в прогоне 03.10.2026), поэтому их незачем опрашивать каждые два часа.
# Остальные источники идут каждый прогон. Кнопка «Запустить прогон» опрашивает
# оба трека без проверки. 0 — выключить трек, опрашивать всё каждый раз.
SYNC_SLOW_INTERVAL_HOURS=6
# ЭТП ГПБ (etpgpb.ru). Поиска для роботов у площадки нет — robots.txt запрещает любой
# адрес с query-строкой, — поэтому адаптер читает карту сайта и карточки по одной, не
# чаще запроса в секунду. Куски карты и прочитанные карточки лежат в data/etpgpb-*.json
# (каталог можно сменить через SYNC_CARD_CACHE_DIR). 1 — выключить источник целиком;
# срок жизни прочитанной карточки в кэше, часы (по умолчанию 72, 0 — не использовать).
# SYNC_ETPGPB_DISABLED=1
# SYNC_ETPGPB_CARD_TTL_HOURS=72
# Период опроса очереди в секундах, не ниже пяти.
SYNC_TICK_SECONDS=10
# Адрес прода: на нём запускается глубокий разбор скачанной документации.
SYNC_BASE_URL=https://tenderfit-ai-sage.vercel.app
# Через сколько минут задание в работе считается потерянным и возвращается
# в очередь. Порог обязан превышать самый долгий прогон, иначе второе
# выполнение начнётся во время первого и файлы качались бы дважды.
SYNC_STALE_JOB_MINUTES=45
# 0 — оставить только очередь, не запуская плановый прогон. Пригодится на время
# переезда, когда старая машина ещё ходит по расписанию Windows: две машины
# в одном расписании означают двойной обход источников.
SYNC_FULL_SYNC=1
# Дорожки воркера (с 14.10.2026): обход источников, живой поиск, документация и
# смета идут одновременно, каждая дорожка — по очереди. 0 — вернуть прежний воркер,
# который делает одно дело за раз: рычаг отката без выкладки кода
# (правка файла + systemctl restart). Пусто или 1 — дорожки включены.
WORKER_PARALLEL=1
# Скорость запросов к ЕИС из дочернего прогона, в секунду (по умолчанию 2). Воркер
# задаёт её сам (1,5 для обхода и для поиска рядом с обходом), здесь переменную
# обычно не трогают: все запросы идут с одного адреса, и ЕИС блокирует его (434).
# EIS_RATE_PER_SEC=2

# ---- Контур.Закупки (платный источник) ---------------------------------
# Тот же ключ, что на Vercel. Тариф даёт 30 запросов в сутки на метод, расход
# виден на /admin/jobs. Пустое значение — источник отключён, сервер работает
# только с ЕИС и Сбербанк-АСТ: документацию они отдают бесплатно.
KONTUR_API_KEY=
# Как часто плановому прогону разрешено опрашивать Контур. Шесть часов при
# прогоне раз в два часа дают 12 поисков в сутки вместо 36 — тариф не
# исчерпывается к обеду, а закупки не теряются: окно поиска равно семи суткам.
KONTUR_MIN_INTERVAL_HOURS=6

# ---- TLS: корень Минцифры (обязательно) --------------------------------
# ЕИС отвечает сертификатом, подписанным Russian Trusted Root CA (Минцифры).
# В наборе Mozilla его нет, поэтому без него любой запрос к zakupki.gov.ru
# падает на проверке цепочки: «self-signed certificate in certificate chain».
# Проверено 25.09.2026 на сервере в Петербурге: с этим файлом карточка закупки
# отдаёт 200 и 188 КБ, без него — ошибку TLS.
#
# Файл кладёт deploy/deploy-worker.sh из deploy/certs/russian_trusted_root_ca.pem,
# сверив отпечаток SHA-256:
#   D2:6D:2D:02:31:B7:C3:9F:92:CC:73:85:12:BA:54:10:35:19:E4:40:5D:68:B5:BD:70:3E:97:88:CA:8E:CF:31
# Тот же отпечаток отдаёт sberbank.ru в своей цепочке — совпадение у двух
# независимых операторов и есть проверка, что корень настоящий.
NODE_EXTRA_CA_CERTS=/etc/tenderfit/russian_trusted_root_ca.pem

# ---- Оповещение о балансе модели (необязательно) -------------------------
# Раз в 30 минут воркер читает баланс шлюза (GET {LLM_BASE_URL}/credits) и
# пишет на ALERT_EMAIL, когда он ниже порога, закончился или пополнен. Без
# ALERT_EMAIL письма выключены. Для проверки нужны LLM_BASE_URL и LLM_API_KEY
# (те же, что у приложения; только на чтение баланса воркер их и использует),
# для отправки — SMTP_* (как в app.env). Состояние «о чём уже писали» лежит в
# data/llm-balance-alert.json (LLM_BALANCE_ALERT_FILE меняет путь).
# Проверка доставки: npx tsx scripts/llm-balance-check.ts --send-test
ALERT_EMAIL=
# LLM_BALANCE_ALERT_RUB=150
LLM_BASE_URL=
LLM_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM=

# Письма о пробном периоде («закончится завтра» и «закончился») воркер шлёт раз
# в час, каждое один раз, через те же SMTP_*. Почты владельцев, которым писать не
# нужно, — ADMIN_EMAILS (через запятую, как в app.env).
ADMIN_EMAILS=

# ---- Чего здесь нет намеренно -------------------------------------------
# NODE_TLS_REJECT_UNAUTHORIZED=0 ставить нельзя ни на одном сервере. Переменная
# отключает проверку сертификатов для всех запросов процесса: любой узел по пути
# смог бы подменить ответ ЕИС или Supabase, а ключ уходит в заголовке. Она
# осталась от локального обхода отсутствующего корня; теперь корень есть, и
# обход не нужен. Воркер предупреждает о переменной при старте.
#
# Модель воркер сам не вызывает. Глубокий разбор выполняет прод:
# сервер только скачивает документацию и вызывает {SYNC_BASE_URL}/api/analysis/worker,
# а LLM_MODEL и остальное живёт в переменных прода. LLM_API_KEY здесь нужен лишь
# ради чтения баланса (см. раздел выше); без оповещения его можно не держать.
