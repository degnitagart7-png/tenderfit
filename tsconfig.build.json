{
  /*
    Конфиг проверки типов для прод-сборки (next build).

    Отличается от tsconfig.json только охватом: сюда попадает ровно то, что
    уезжает на сайт. Причина — `next build` проверяет типы по всему, что
    перечислено в include, и падал на коде, которого в приложении нет:

    - `scripts/**` — оффлайновые утилиты (сбор ЕИС, сборка индекса ФСНБ),
      запускаются руками через tsx и в бандл не входят;
    - `*.test.ts(x)` и `src/test/**` — тесты, их проверяет vitest;
    - расчёт сметы (`src/domain/estimate/**` и его единственные потребители
      `src/repositories/estimateBaseRepository.ts`, `src/lib/fsnb/**`) — работа
      в процессе. Ни один маршрут и ни один компонент их не импортирует:
      область достижима только из `scripts/fsnb/*`, то есть на сайт не едет.

    Строгость не ослаблена: `npm run typecheck` по-прежнему читает базовый
    tsconfig.json и проверяет весь репозиторий целиком, включая всё вышеперечисленное.
    Этот файл не прячет ошибки — он лишь не даёт незавершённой офлайн-части
    блокировать выкладку интерфейса.
  */
  "extends": "./tsconfig.json",
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "scripts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/test",
    "src/domain/estimate",
    "src/lib/fsnb",
    "src/repositories/estimateBaseRepository.ts"
  ]
}
