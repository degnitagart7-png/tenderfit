# Демо-режим: сервис работает на mock-данных, реальные запросы в ЕИС не выполняются.
# Пустое значение NEXT_PUBLIC_DATA_SOURCE=mock включает демонстрационную базу.
NEXT_PUBLIC_DATA_SOURCE=mock

# Параметры реального адаптера ЕИС (используются только при NEXT_PUBLIC_DATA_SOURCE=eis
# и запуске серверного скрипта scripts/scrape-eis.ts).
# ВНИМАНИЕ: соблюдайте rate-limit ~3 запроса/сек и retry с backoff.
EIS_BASE_URL=https://zakupki.gov.ru
EIS_RATE_LIMIT_PER_SEC=3
EIS_CACHE_TTL_FEED_SEC=300
EIS_CACHE_TTL_CARD_SEC=86400

# Контур.Закупки — ПЛАТНЫЙ API: 44-ФЗ, 223-ФЗ, 615-ПП и коммерческие торги
# с 400+ электронных площадок. Ключ выдаётся в Кабинете Интегратора
# (integrations.kontur.ru) после подключения тарифа; без него источник отключён,
# а приложение работает на ЕИС и Сбербанк-АСТ.
#
# Контракт подтверждён спецификацией OpenAPI 3.0.4 «АПИ Закупок» и живым зондом
# 23.09.2026 — подробности в docs/REFERENCE_KONTUR_API.md. Значения ниже
# совпадают с KONTUR_CONTRACT_DEFAULTS в konturContract.ts: их можно не задавать
# вовсе, а переопределять стоит только если вендор сменит адрес или заголовок.
#
# Экономия запросов: остаток по тарифу читается бесплатным /limitGroups,
# повторный одинаковый поиск берётся из кэша сырых ответов (kontur_raw_responses),
# дневной бюджет ограничивает расход, а все обращения пишутся в api_usage_log.
KONTUR_API_KEY=
KONTUR_API_BASE_URL=https://api-zakupki.kontur.ru
# Авторизация: ключ передаётся значением заголовка как есть, БЕЗ схемы
# («X-Kontur-Apikey: <ключ>»). KONTUR_API_AUTH_SCHEME= (пусто) — это заданное
# значение, а не «использовать Bearer».
KONTUR_API_AUTH_HEADER=X-Kontur-Apikey
KONTUR_API_AUTH_SCHEME=
# Пути эндпоинтов. Метода для документов нет: ссылки приходят полем Docs карточки.
KONTUR_API_SEARCH_PATH=/external/v1/search
KONTUR_API_TENDER_PATH=/external/v1/purchases/{id}
# Бесплатные эндпоинты: тестовая карточка (данные не закрашены, но только id из
# спецификации) и остаток суточных лимитов по группам методов.
KONTUR_API_TEST_TENDER_PATH=/external/v1/testpurchases/{id}
KONTUR_API_LIMIT_GROUPS_PATH=/external/v1/limitGroups
# Ограничение частоты (запросов в секунду; API допускает не больше пяти
# одновременных обращений на ключ) и дневной бюджет платных запросов.
# Бюджет считается НА КАЖДЫЙ МЕТОД отдельно (поиск и карточка — разные группы
# тарифа), это страховка на случай, когда тариф прочитать не удалось: настоящий
# остаток отдаёт /limitGroups. 0 или меньше — без ограничения.
# Боевой тариф с 24.09.2026 — 30 запросов в сутки на метод, значение по
# умолчанию совпадает с ним; занижать смысла нет, завышать опасно.
KONTUR_RATE_LIMIT_PER_SEC=2
KONTUR_DAILY_REQUEST_LIMIT=30
# Как часто плановый прогон scripts/sync-eis.ts вправе опрашивать Контур.Закупки.
# Задание работает каждые два часа, три ключевых слова профиля стоят три поиска,
# а тариф даёт 30 поисков в сутки: без интервала расход составил бы 36. Шесть
# часов — 12 поисков в сутки, закупки не теряются, потому что окно поиска равно
# семи суткам. 0 — опрашивать каждый прогон (расход ограничит только бюджет).
# Явный запуск --sources=KONTUR интервал игнорирует.
KONTUR_MIN_INTERVAL_HOURS=6
# Время жизни кэша: поиск — сутки, карточка закупки — 7 дней. Ключ кэша поиска
# выравнивается по часу, поэтому свежесть выдачи ограничена часом независимо от
# TTL: уменьшать его ради свежести не нужно, это только лишний расход.
KONTUR_CACHE_TTL_SEARCH_SEC=86400
KONTUR_CACHE_TTL_CARD_SEC=604800

# Воркер на российской машине (scripts/worker.ts).
#
# Зачем он нужен: ЕИС и её хранилище файлов не отвечают зарубежным адресам, а
# прод живёт на Vercel. Поиск по кнопке идёт в Контур.Закупки и оттуда работает,
# а скачать документацию может только машина с российским IP. Без запущенного
# воркера очередь analysis_jobs наполняется, документы не приходят, и карточка
# закупки честно показывает «задача в очереди, документов ещё нет».
#
# Запуск:
#   npx tsx scripts/worker.ts           — демон, тик раз в SYNC_TICK_SECONDS
#   npx tsx scripts/worker.ts --once    — один тик и выход; печатает адрес
#                                         выхода в сеть и страну, с этого и
#                                         начинается разбор «почему нет файлов»
#
# Невозможные значения воркер молча исправляет к безопасным и пишет об этом в
# стартовой строке лога: падение из-за опечатки в переменной оставило бы партнёра
# без документации до ручного вмешательства.

# Имя воркера в пульсе worker_heartbeat. Менять нужно, только если документацию
# качают две машины: пульс у них общий, и под одним именем они будут перетирать
# записи друг друга.
SYNC_WORKER_ID=ru-vps
# Период планового обхода источников, часов.
SYNC_INTERVAL_HOURS=2
# Период опроса очереди заданий, секунд. Значение меньше 5 поднимается до 5;
# ноль и нечисло — туда же, оба означают «слишком часто».
SYNC_TICK_SECONDS=60
# 0, false, off или no — отключить плановый обход, оставив только очередь.
# Нужно на машине, которая должна лишь догружать документацию по нажатию кнопки.
SYNC_FULL_SYNC=1
# Адрес прода: там живёт воркер AI-разбора, у которого лежит ключ шлюза модели.
# Значение по умолчанию совпадает с этим — задавать стоит только при смене домена.
SYNC_BASE_URL=https://tenderfit-ai-sage.vercel.app
# Через сколько минут задание, застрявшее в processing, возвращается в очередь.
# Страховка от перезагрузки машины посреди загрузки документации.
SYNC_STALE_JOB_MINUTES=45

# Подключение к базе. Воркеру обязательны оба: пульс, очередь заданий и таблица
# документов пишутся сервисной ролью. Ключ сервисной роли обходит RLS — он живёт
# только на сервере и никогда не попадает в браузер.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Языковая модель для разбора документации (src/services/llmGateway.ts).
# Читаются LLM_*; прежние OPENROUTER_API_KEY, OPENROUTER_BASE_URL и
# OPENROUTER_MODEL остались запасными именами. Шлюз с 2026-09-22 российский
# (routerai.ru) и отвечает с обоих концов, поэтому разбор идёт на проде.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Ключ владельца для /api/sync-profiles: им закрыта отправка профилей сбора с
# страницы настроек (входа в приложении нет). Не короче 12 знаков; пусто или
# короче — ручка выключена (503). Задаётся на сервере приложения, в браузере его
# вводит только владелец. Например: openssl rand -hex 16
ADMIN_TOKEN=

# Вход по коду из письма (/login). Нужны оба условия, иначе вход выключен и
# ссылки «Войти» на сайте нет:
#  1) AUTH_SECRET — секрет для хэшей кодов и сессий, не короче 16 знаков
#     (например: openssl rand -hex 32). Смена секрета разлогинивает всех;
#  2) почтовый сервер SMTP: SMTP_HOST, SMTP_PORT (465 — TLS сразу, иначе
#     STARTTLS), SMTP_USER, SMTP_PASSWORD, SMTP_FROM (адрес отправителя).
#     Подойдёт Яндекс 360 для бизнеса или транзакционный сервис вроде
#     Unisender Go. Почту Google для регистрации сервис не принимает.
AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# NODE_TLS_REJECT_UNAUTHORIZED здесь быть не должно ни в каком значении: она
# отключает проверку TLS-сертификатов для всего процесса. Переменная осталась от
# обхода корпоративного прокси; воркер предупреждает о ней при старте.

# Этих имён код не читает — если они есть в вашем .env.local, их можно удалить:
# SUPABASE_ANON_KEY, LLM_PROVIDER_API_KEY, NOTIFICATION_EMAIL_FROM.
