.vercel
node_modules
.next

# Секреты: ключ Supabase service_role, платные ключи Контур.Закупок и LLM.
.env
.env.*
!.env.example

# Локальный мусор: деплой Vercel публикует всё дерево, поэтому журналы
# плановой синхронизации и кэш сборки на сервер попадать не должны.
logs
*.tsbuildinfo
*.sst

# Нормативные базы ФСНБ-2022 из открытых данных ФГИС ЦС: ~350 МБ исходников
# и индексов. Скачиваются скриптом scripts/fsnb/download.ts, в прод не идут.
data/fsnb/*
# Нормативы, перенесённые из приказов (JSON и сохранённые тексты первоисточников) — малы и идут в репозиторий.
!data/fsnb/normatives
.firecrawl

# Общее состояние затвора запросов к ЕИС (src/lib/eisGate.ts): карантин после HTTP
# 434/403/429 живёт на машине, где идут запросы, и в репозиторий не попадает.
data/eis-gate.json
data/eis-gate.json.*.tmp

# Кэши адаптера ЭТП ГПБ (src/adapters/tender-source/etpgpbCache.ts): куски карты сайта и
# прочитанные карточки. Живут на машине, где идут запросы, и в репозиторий не попадают.
data/etpgpb-*.json
data/etpgpb-*.json.*.tmp

# Документация живых закупок и письма Минстроя с индексами: ~93 МБ исходников,
# из которых собирается проверка расчёта сметы. В архив воркера и в прод не идут —
# это материал для локальной отладки, а не часть кода.
Письма МИНСТРОЙ
Документация о закупке*

# Файл, который Windows создал вместо устройства: `> nul` в Git Bash пишет на диск.
nul

# Рабочие материалы, не код: выгрузки brag, списки для продаж, примеры смет в корне.
brag-output*
sales/
/*.xlsx
eis-sample.json

# Видео и звук для роликов (десятки мегабайт) — рабочие материалы, не код.
marketing/**/*.mp4
marketing/**/*.wav
.DS_Store

# Архив собранных файлов сайта для nginx (deploy-app.sh) — результат сборки, не код.
static-archive/
